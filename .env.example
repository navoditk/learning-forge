DATABASE_URL="postgresql://learning_forge@localhost:5432/learning_forge?schema=public"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"
# Only needed to run scripts/run-real-eval.ts, or if TUTOR_MODEL_PROVIDER=anthropic below.
ANTHROPIC_API_KEY="replace-with-a-real-key"
# Supported values: "fake" or "anthropic". Unset/unsupported values fail closed
# to the deterministic fake adapter. Credentials never select a provider.
# Tests/CI always force the fake adapter (see playwright.config.ts).
TUTOR_MODEL_PROVIDER="fake"
# Maximum real or fake tutor requests per household in a rolling 24-hour period.
TUTOR_DAILY_HINT_LIMIT="100"
# Maximum tutor requests associated with one learner session.
TUTOR_SESSION_HINT_LIMIT="8"
# Supported values: "console" or "resend". Unset/unsupported values fail
# closed to the log-only console adapter - a flagged safety turn is logged,
# not emailed, until this is explicitly set. Tests/CI always use "console".
NOTIFIER_PROVIDER="console"
# Only needed if NOTIFIER_PROVIDER=resend. Create a free account at
# resend.com and generate an API key from its dashboard.
RESEND_API_KEY="replace-with-a-real-key"
# Only needed if NOTIFIER_PROVIDER=resend. Resend's shared testing address
# (onboarding@resend.dev) works without verifying a sending domain.
SAFETY_ALERT_EMAIL_FROM="onboarding@resend.dev"
# Only needed if NOTIFIER_PROVIDER=resend. The child-safety escalation
# destination named in docs/incident-response.md.
SAFETY_ALERT_EMAIL_TO="replace-with-the-escalation-destination-address"
