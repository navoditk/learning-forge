{
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(shasum *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run content:validate)",
      "Bash(scripts/agent-claim.sh status)",
      "Bash(scripts/orient.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/orient.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/format-edited.sh"
          }
        ]
      }
    ]
  }
}
